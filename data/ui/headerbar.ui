<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkButton" id="applyButton">
    <property name="visible">True</property>
    <property name="tooltip-text" translatable="yes">Apply</property>
    <property name="icon-name">object-select-symbolic</property>
    <style>
      <class name="suggested-action"/>
    </style>
  </object>
  <object class="GtkPopoverMenu" id="menuPopover">
    <property name="position">bottom</property>
  </object>
  <object class="GtkMenuButton" id="menuBtn">
    <property name="visible">True</property>
    <property name="tooltip-text" translatable="yes">Menu</property>
    <property name="popover">menuPopover</property>
    <property name="icon-name">open-menu-symbolic</property>
  </object>
  <object class="GtkPopover" id="wallpapersFoldersPopover">
    <property name="height-request">350</property>
  </object>
  <object class="GtkMenuButton" id="wallpapersFoldersBtn">
    <property name="visible">True</property>
    <property name="tooltip-text" translatable="yes">Wallpapers Folders</property>
    <property name="popover">wallpapersFoldersPopover</property>
    <property name="icon-name">folder-symbolic</property>
  </object>
  <object class="GtkButton" id="add_to_slideshow_btn">
    <property name="icon-name">list-add-symbolic</property>
    <property name="visible">False</property>
    <property name="tooltip-text" translatable="yes">Add to slideshow</property>
    <style>
      <class name="suggested-action"/>
    </style>
  </object>
  <object class="GtkMenuButton" id="slideshow_menu_btn">
    <property name="icon-name">slideshowmode-symbolic</property>
    <property name="popover">slideshow_popover</property>
    <property name="tooltip-text" translatable="yes">Manage slideshow mode</property>
  </object>
  <object class="GtkPopover" id="slideshow_popover">
    <property name="height-request">350</property>
    <property name="width-request">250</property>
    <child>
      <object class="GtkBox" id="slideshow_popover_inner_box">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vexpand">1</property>
            <style>
              <class name="frame"/>
            </style>
            <child>
              <object class="GtkListBox" id="slideshow_listbox">
                <property name="vexpand">1</property>
                <property name="show-separators">1</property>
                <property name="selection-mode">none</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkGrid">
            <property name="row_spacing">6</property>
            <property name="column_spacing">6</property>
            <property name="orientation">horizontal</property>
            <property name="hexpand">1</property>
            <child>
              <object class="GtkLabel">
                <property name="hexpand">1</property>
                <property name="halign">start</property>
                <property name="label" translatable="yes">Slideshow mode</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSwitch" id="slideshow_switch">
              <property name="halign">center</property>
              <layout>
                <property name="row">0</property>
                <property name="column">1</property>
              </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="hexpand">1</property>
                <property name="halign">start</property>
                <property name="label" translatable="yes">Seconds between wallpaper change</property>
                <layout>
                  <property name="row">1</property>
                  <property name="column">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="slideshow_time_spinbutton">
              <property name="numeric">1</property>
              <layout>
                <property name="row">1</property>
                <property name="column">1</property>
              </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="hexpand">1</property>
            <property name="halign">start</property>
            <property name="xalign">0.0</property>
            <property name="wrap">1</property>
            <property name="wrap-mode">word-char</property>
            <property name="max-width-chars">40</property>
            <property name="use-markup">1</property>
            <property name="label" translatable="yes">Make sure you have added the HydraPaper Daemon as a &lt;b&gt;Startup Application&lt;/b&gt;. &lt;a href="https://help.gnome.org/users/gnome-help/stable/shell-apps-auto-start.html"&gt;Learn how&lt;/a&gt;</property>
            <layout>
              <property name="row">1</property>
              <property name="column">0</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
